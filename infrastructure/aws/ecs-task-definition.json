{
  "family": "envisionnow-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "REPLACE_WITH_ECS_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_WITH_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "envisionnow-backend",
      "image": "REPLACE_WITH_ECR_IMAGE_URI",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "https://envisionnow.tv,https://www.envisionnow.tv"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_JWT_ARN"
        },
        {
          "name": "OWNER_EMAIL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_OWNER_EMAIL_ARN"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "REPLACE_WITH_SECRETS_MANAGER_DATABASE_URL_ARN"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/envisionnow-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}